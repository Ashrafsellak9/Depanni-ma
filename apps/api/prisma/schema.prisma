// DEPANNI.ma — Prisma schema (PostgreSQL 16 + PostGIS)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  CITIZEN
  ARTISAN
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

enum ArtisanVerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum EarningStatus {
  PENDING
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  TEMPLATE
  LOCATION
  SYSTEM
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  phone          String         @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  bio            String?
  role           UserRole       @default(CITIZEN)
  status         UserStatus     @default(PENDING)
  locale         String         @default("fr")
  emailVerified  Boolean        @default(false)
  phoneVerified  Boolean        @default(false)
  artisan        Artisan?
  jobs           Job[]          @relation("CitizenJobs")
  addresses      UserAddress[]
  reviewsGiven   Review[]       @relation("CitizenReviews")
  messagesSent   Message[]      @relation("MessagesSent")
  messageReads   MessageRead[]
  refreshTokens  RefreshToken[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("users")
}

model UserAddress {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      AddressLabel @default(HOME)
  street     String?
  city       String
  region     String?
  postalCode String?
  country    String       @default("MA")
  formatted  String
  lat        Float
  lng        Float
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@map("user_addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  jti       String   @unique
  familyId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model ServiceCategory {
  id        String            @id @default(uuid())
  slug      String            @unique
  nameFr    String
  nameAr    String?
  artisans  ArtisanCategory[]
  jobs      Job[]
  createdAt DateTime          @default(now())

  @@map("service_categories")
}

model ArtisanCategory {
  artisanId  String
  categoryId String
  artisan    Artisan         @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([artisanId, categoryId])
  @@map("artisan_categories")
}

model Artisan {
  id                 String                    @id @default(uuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus ArtisanVerificationStatus @default(UNVERIFIED)
  rejectionReason    String?
  isVerified         Boolean                   @default(false)
  isTopArtisan       Boolean                   @default(false)
  cinNumber          String?
  cinDocumentUrl     String?
  cinRectoUrl        String?
  cinVersoUrl        String?
  tradeLicenseUrl    String?
  diplomaUrl         String?
  bio                String?
  specialties        String[]                  @default([])
  zones              String[]                  @default([])
  hourlyRate         Float?
  serviceRadiusKm    Float                     @default(15)
  baseLat            Float?
  baseLng            Float?
  currentLat         Float?
  currentLng         Float?
  isAvailable        Boolean                   @default(false)
  rating             Float                     @default(0)
  artisanScore       Float                     @default(0)
  completionRate     Float                     @default(0)
  avgResponseTimeSec Int                       @default(0)
  cancellationRate   Float                     @default(0)
  completedJobs      Int                       @default(0)
  totalEarnings      Float                     @default(0)
  categories         ArtisanCategory[]
  offers             Offer[]
  reviews            Review[]
  earnings           ArtisanEarning[]
  payouts            Payout[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@map("artisans")
}

model Review {
  id        String   @id @default(uuid())
  artisanId String
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   User     @relation("CitizenReviews", fields: [citizenId], references: [id])
  jobId     String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([artisanId])
  @@map("reviews")
}

model ArtisanEarning {
  id          String        @id @default(uuid())
  artisanId   String
  artisan     Artisan       @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  jobId       String?
  grossAmount Float
  commission  Float
  netAmount   Float
  status      EarningStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([artisanId])
  @@map("artisan_earnings")
}

model Payout {
  id          String       @id @default(uuid())
  artisanId   String
  artisan     Artisan      @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  amount      Float
  status      PayoutStatus @default(PENDING)
  reference   String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([artisanId])
  @@map("payouts")
}

model Job {
  id                String           @id @default(uuid())
  citizenId         String
  citizen           User             @relation("CitizenJobs", fields: [citizenId], references: [id])
  categoryId        String
  category          ServiceCategory  @relation(fields: [categoryId], references: [id])
  subcategory       String?
  title             String
  description       String
  photos            String[]         @default([])
  status            JobStatus        @default(PENDING)
  urgency           String           @default("NORMAL")
  locationLat       Float
  locationLng       Float
  address           String
  city              String
  currency          String           @default("MAD")
  budgetMin         Float?
  budgetMax         Float?
  diffusionRadiusKm Float            @default(2)
  offerCount        Int              @default(0)
  maxOffers         Int              @default(10)
  acceptsOffers     Boolean          @default(true)
  expiresAt         DateTime?
  scheduledAt       DateTime?
  acceptedOfferId   String?          @unique
  acceptedOffer     Offer?           @relation("AcceptedJobOffer", fields: [acceptedOfferId], references: [id])
  offers            Offer[]          @relation("JobOffers")
  conversation      Conversation?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([citizenId])
  @@index([status])
  @@index([city])
  @@index([categoryId])
  @@map("jobs")
}

model Offer {
  id         String      @id @default(uuid())
  jobId      String
  job        Job         @relation("JobOffers", fields: [jobId], references: [id], onDelete: Cascade)
  acceptedForJob Job?    @relation("AcceptedJobOffer")
  artisanId  String
  artisan    Artisan     @relation(fields: [artisanId], references: [id])
  amount     Float
  currency   String      @default("MAD")
  etaMinutes Int?
  message    String?
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([jobId, artisanId])
  @@index([jobId])
  @@map("offers")
}

model Conversation {
  id        String    @id @default(uuid())
  jobId     String    @unique
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])
  type           MessageType  @default(TEXT)
  content        String?
  mediaUrl       String?
  templateId     String?
  metadata       Json?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  readBy         MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageRead {
  messageId String
  userId    String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@id([messageId, userId])
  @@map("message_reads")
}
