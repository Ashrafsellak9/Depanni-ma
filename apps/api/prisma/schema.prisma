// DEPANNI.ma — Schéma Prisma complet (PostgreSQL 16 + PostGIS)
// Après changement majeur : prisma migrate reset && prisma db seed

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  ARTISAN
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionTier {
  STANDARD
  PREMIUM
  PRO
}

enum AvailabilityStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum JobStatus {
  PENDING
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum JobUrgency {
  NOW
  IN2H
  SCHEDULED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MissionStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  HELD
  ESCROW
  RELEASED
  REFUNDED
  FAILED
  DISPUTED
  FROZEN
}

enum WalletTxType {
  CREDIT
  DEBIT
  COMMISSION
  PAYOUT
  REFUND
  TOPUP
}

enum PayoutStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  TEMPLATE
  LOCATION
  SYSTEM
}

enum ReviewTargetType {
  ARTISAN
  CITIZEN
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET
  VERIFY_PHONE
}

// ─── Auth & users ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  email        String    @unique
  passwordHash String
  role          UserRole      @default(CITIZEN)
  accountStatus AccountStatus @default(ACTIVE)
  isVerified    Boolean       @default(false)
  locale        String        @default("fr")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  citizen        Citizen?
  artisan        Artisan?
  refreshTokens  RefreshToken[]
  pushDevices    DevicePushToken[]
  notifications  Notification[]
  messagesSent   Message[]      @relation("MessagesSent")
  reviewsAuthored Review[]      @relation("ReviewsAuthored")

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  jti        String   @unique
  familyId   String
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  deviceInfo String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_push_tokens")
}

model OtpCode {
  id        String     @id @default(uuid())
  phone     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  isUsed    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ─── Profils ─────────────────────────────────────────────────────────────────

model Citizen {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  avatar    String?
  addresses Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs     Job[]
  missions Mission[] @relation("MissionCitizen")
  payments Payment[]

  @@map("citizens")
}

model Artisan {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  avatar             String?
  bio                String?
  specialties        String[]           @default([])
  kycStatus          KycStatus          @default(PENDING)
  kycDocUrls         String[]           @default([])
  kycReviewedAt      DateTime?
  kycRejectReason    String?
  subscriptionTier   SubscriptionTier   @default(STANDARD)
  lat                Float?
  lng                Float?
  /// Colonne SQL `location geography(Point,4326)` + index GIST `artisans_location_gix` (migration 20260525140000)
  rating             Float              @default(0)
  totalMissions      Int                @default(0)
  badgeVerified      Boolean            @default(false)
  badgeTop           Boolean            @default(false)
  availabilityStatus AvailabilityStatus @default(OFFLINE)
  zones              String[]           @default([])
  serviceRadiusKm    Float              @default(15)
  hourlyRate         Float?
  cinNumber          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  offers        Offer[]
  missions      Mission[]            @relation("MissionArtisan")
  wallet        Wallet?
  walletTx      WalletTransaction[]
  payouts       Payout[]
  subscriptions ArtisanSubscription[]
  payments      Payment[]

  @@index([kycStatus])
  @@index([availabilityStatus])
  @@map("artisans")
}

model ArtisanSubscription {
  id        String           @id @default(uuid())
  artisanId String
  artisan   Artisan          @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  tier      SubscriptionTier
  price     Float
  startedAt DateTime         @default(now())
  expiresAt DateTime
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@index([artisanId, isActive])
  @@map("artisan_subscriptions")
}

// ─── Marketplace ─────────────────────────────────────────────────────────────

model ServiceCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameFr    String
  nameAr    String?
  createdAt DateTime @default(now())

  @@map("service_categories")
}

model Job {
  id          String     @id @default(uuid())
  citizenId   String
  citizen     Citizen    @relation(fields: [citizenId], references: [id])
  category    String
  subcategory String?
  title       String
  description String
  photos      String[]   @default([])
  lat         Float
  lng         Float
  address     String
  city        String     @default("Casablanca")
  urgency     JobUrgency @default(NOW)
  budgetMin   Float?
  budgetMax   Float?
  status      JobStatus  @default(PENDING)
  scheduledAt DateTime?
  expiresAt   DateTime?
  offerCount  Int        @default(0)
  maxOffers   Int        @default(10)
  acceptsOffers Boolean  @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  offers  Offer[]
  mission Mission?

  @@index([lat, lng])
  @@index([status, category])
  @@index([citizenId])
  @@map("jobs")
}

model Offer {
  id        String      @id @default(uuid())
  jobId     String
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artisanId String
  artisan   Artisan     @relation(fields: [artisanId], references: [id])
  price     Float
  etaMinutes Int?
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  mission Mission?

  @@unique([jobId, artisanId])
  @@index([artisanId, status])
  @@index([jobId])
  @@map("offers")
}

model Mission {
  id               String        @id @default(uuid())
  jobId            String        @unique
  job              Job           @relation(fields: [jobId], references: [id])
  offerId          String        @unique
  offer            Offer         @relation(fields: [offerId], references: [id])
  citizenId        String
  citizen          Citizen       @relation("MissionCitizen", fields: [citizenId], references: [id])
  artisanId        String
  artisan          Artisan       @relation("MissionArtisan", fields: [artisanId], references: [id])
  status           MissionStatus @default(ACCEPTED)
  startedAt        DateTime?
  completedAt      DateTime?
  artisanLat       Float?
  artisanLng       Float?
  totalAmount      Float
  commissionAmount Float         @default(0)
  artisanNet       Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payments Payment[]
  messages Message[]
  reviews  Review[]

  @@index([citizenId])
  @@index([artisanId])
  @@index([status])
  @@map("missions")
}

// ─── Paiements & wallet ──────────────────────────────────────────────────────

model Payment {
  id               String        @id @default(uuid())
  idempotencyKey   String?       @unique
  missionId        String
  mission          Mission       @relation(fields: [missionId], references: [id])
  citizenId        String
  citizen          Citizen       @relation(fields: [citizenId], references: [id])
  artisanId        String?
  artisan          Artisan?      @relation(fields: [artisanId], references: [id])
  amount           Float
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  cmiRef           String?       @unique
  commissionRate   Float         @default(0.15)
  commissionAmount Float         @default(0)
  artisanNetAmount Float         @default(0)
  currency         String        @default("MAD")
  heldAt           DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  disputeOpenedAt  DateTime?
  disputeReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  auditLogs PaymentAuditLog[]

  @@index([missionId])
  @@index([citizenId])
  @@index([status])
  @@map("payments")
}

model PaymentAuditLog {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action    String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_audit_logs")
}

model Wallet {
  id        String   @id @default(uuid())
  artisanId String   @unique
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("MAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id            String       @id @default(uuid())
  artisanId     String
  artisan       Artisan      @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  type          WalletTxType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String?
  description   String?
  createdAt     DateTime     @default(now())

  @@index([artisanId])
  @@index([reference])
  @@map("wallet_transactions")
}

model Payout {
  id          String       @id @default(uuid())
  artisanId   String
  artisan     Artisan      @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  amount      Float
  bankDetails Json?
  status      PayoutStatus @default(PENDING)
  reference   String?
  batchId     String?
  initiatedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([artisanId])
  @@index([status])
  @@index([batchId])
  @@map("payouts")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  targetType String
  targetId   String
  actorId    String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ─── Chat & avis ─────────────────────────────────────────────────────────────

model Message {
  id         String      @id @default(uuid())
  missionId  String
  mission    Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation("MessagesSent", fields: [senderId], references: [id])
  type       MessageType @default(TEXT)
  content    String?
  fileUrl    String?
  isRead     Boolean     @default(false)
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([missionId])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id         String           @id @default(uuid())
  missionId  String
  mission    Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User             @relation("ReviewsAuthored", fields: [authorId], references: [id])
  targetId   String
  targetType ReviewTargetType
  rating     Int
  comment    String?
  criteria   Json?
  createdAt  DateTime         @default(now())

  @@index([missionId])
  @@index([targetId, targetType])
  @@map("reviews")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean             @default(false)
  channel   NotificationChannel @default(PUSH)
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}
