{
  "name": "@depanni/api",
  "version": "0.1.0",
  "private": true,
  "description": "DEPANNI.ma API — Node.js + Express 5 + Prisma",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -o -- tsx watch src/server.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -o -- node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "db:generate": "dotenv -e ../../.env -o -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -o -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -o -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -o -- prisma studio",
    "db:push": "dotenv -e ../../.env -o -- prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@depanni/types": "workspace:*",
    "@depanni/utils": "workspace:*",
    "@depanni/validators": "workspace:*",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.1",
    "twilio": "^6.0.2",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@depanni/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
