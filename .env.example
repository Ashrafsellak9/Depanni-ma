# Clé serveur FCM (legacy) si nécessaire
FCM_SERVER_KEY=

# --- Expo Notifications ---
EXPO_ACCESS_TOKEN=

# --- Stockage S3 compatible (Cloudflare R2) ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=depanni-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.depanni.ma

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
# Prometheus metrics endpoint (API)
METRICS_PORT=9090
PROMETHEUS_ENABLED=false

# --- Email (optionnel — notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@depanni.ma

# --- Admin ---
ADMIN_JWT_SECRET=change-me-admin-secret
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Socket.io ---
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Performance / monitoring (optionnel) ---
DATABASE_POOL_SIZE=10
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
