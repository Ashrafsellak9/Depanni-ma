# =============================================================================
# DEPANNI.ma — Variables d'environnement
# Copier ce fichier vers .env à la racine et adapter les valeurs
# =============================================================================

# --- Général ---
NODE_ENV=development
# URL publique de l'API (utilisée par web, admin, mobile)
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- API (apps/api) ---
API_PORT=4000
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Base de données (PostgreSQL 16 + PostGIS) ---
DATABASE_URL=postgresql://depanni:depanni_dev@localhost:5433/depanni?schema=public

# --- Redis 7 (sessions, rate limit, pub/sub Socket.io) ---
REDIS_URL=redis://localhost:6379

# --- Auth JWT (RS256) ---
# Access token : 15 min | Refresh token : 7 jours (httpOnly cookie + hash DB)
# En dev, des clés RSA sont générées automatiquement si absentes.
# Production : openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=depanni_refresh
COOKIE_SECURE=false
# COOKIE_DOMAIN=.depanni.ma

# --- OTP (Redis) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LOCK_SECONDS=1800

# --- OTP SMS (Twilio) ---
# SMS OTP (Twilio). En développement, si vide : le code OTP est renvoyé
# dans la réponse API (champ devOtp) et loggé — jamais en production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Paiement CMI Maroc ---
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
CMI_CALLBACK_URL=http://localhost:4000/api/payments/cmi/callback
CMI_RETURN_URL=http://localhost:3000/payment/success
CMI_FAIL_URL=http://localhost:3000/payment/fail

# --- Wallet & commissions ---
WALLET_COMMISSION_RATE_STANDARD=0.15
WALLET_COMMISSION_RATE_PREMIUM=0.10
WALLET_COMMISSION_RATE_PRO=0.07
DISPUTE_FREEZE_HOURS=72

# --- Google Maps Platform ---
# API (serveur) : Directions, Geocoding, Distance Matrix
GOOGLE_MAPS_API_KEY=
# Web / Admin (cartes navigateur) — si vide, repli sur GOOGLE_MAPS_API_KEY au build
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Mobile Expo (react-native-maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- CARTO Basemaps (carte de couverture landing Leaflet) ---
# Clé gratuite : https://carto.com/basemaps/apikey — ne pas committer la vraie valeur
# Domaines autorisés : localhost, depanni.ma
NEXT_PUBLIC_CARTO_API_KEY=

# --- Firebase Cloud Messaging (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Clé serveur FCM (legacy) si nécessaire
FCM_SERVER_KEY=

# --- Expo Notifications ---
EXPO_ACCESS_TOKEN=

# --- Stockage S3 compatible (Cloudflare R2) ---
# Développement : laisser vide → fallback local apps/api/.uploads
#               servi sur http://localhost:4000/uploads/...
# Production  : OBLIGATOIRE — l'API refuse de démarrer sans ces 5 variables.
#               Créer un bucket R2 + API token (Object Read & Write) + domaine custom.
#               Ne pas utiliser d'ACL (R2) : publier via le domaine S3_PUBLIC_URL.
# Exemple prod : https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
# Prometheus metrics endpoint (API)
METRICS_PORT=9090
PROMETHEUS_ENABLED=false

# --- Site public (apps/web) ---
NEXT_PUBLIC_SITE_URL=https://depanni.ma

# --- Email transactionnel (Resend) ---
# À brancher pour les notifications e-mail (demande artisan, OTP e-mail, etc.)
RESEND_API_KEY=

# --- Email (optionnel — SMTP fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@depanni.ma

# --- Admin ---
ADMIN_JWT_SECRET=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Seed local (optionnel — surcharge apps/api/prisma/seed.credentials.ts) ---
# Ancien couple compromis : admin@depanni.ma / Depanni@2026! (ne plus utiliser)
# SEED_ADMIN_EMAIL=ops@depanni.ma
# SEED_ADMIN_PHONE=+212600000001
# SEED_PASSWORD=Seed!Depanni9kQx

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Socket.io ---
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Performance / monitoring (optionnel) ---
DATABASE_POOL_SIZE=10
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
