# =============================================================================
# DEPANNI.ma — Variables d'environnement
# Copier ce fichier vers .env à la racine et adapter les valeurs
# =============================================================================

# --- Général ---
NODE_ENV=development
# URL publique de l'API (utilisée par web, admin, mobile)
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- API (apps/api) ---
API_PORT=4000
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Base de données (PostgreSQL 16 + PostGIS) ---
DATABASE_URL=postgresql://depanni:depanni_dev@localhost:5433/depanni?schema=public

# --- Redis 7 (sessions, rate limit, pub/sub Socket.io) ---
REDIS_URL=redis://localhost:6379

# --- Auth JWT (RS256) ---
# Access token : 15 min | Refresh token : 7 jours (httpOnly cookie + hash DB)
# En dev, des clés RSA sont générées automatiquement si absentes.
# Production : openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=depanni_refresh
COOKIE_SECURE=false
# COOKIE_DOMAIN=.depanni.ma

# --- OTP (Redis) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LOCK_SECONDS=1800

# --- OTP SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Paiement CMI Maroc ---
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
CMI_CALLBACK_URL=http://localhost:4000/api/v1/payments/cmi/callback
CMI_RETURN_URL=http://localhost:3000/payment/success

# --- Wallet & commissions ---
WALLET_COMMISSION_RATE_STANDARD=0.15
WALLET_COMMISSION_RATE_PREMIUM=0.10
WALLET_COMMISSION_RATE_PRO=0.07
DISPUTE_FREEZE_HOURS=72

# --- Google Maps Platform ---
# API (serveur) : Directions, Geocoding, Distance Matrix
GOOGLE_MAPS_API_KEY=
# Web / Admin (cartes navigateur) — si vide, repli sur GOOGLE_MAPS_API_KEY au build
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Mobile Expo (react-native-maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Firebase Cloud Messaging (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Clé serveur FCM (legacy) si nécessaire
FCM_SERVER_KEY=

# --- Expo Notifications ---
EXPO_ACCESS_TOKEN=

# --- Stockage S3 compatible (Cloudflare R2) not in dev---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=depanni-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.depanni.ma

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
# Prometheus metrics endpoint (API)
METRICS_PORT=9090
PROMETHEUS_ENABLED=false

# --- Email (optionnel — notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@depanni.ma

# --- Admin ---
ADMIN_JWT_SECRET=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Socket.io ---
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Performance / monitoring (optionnel) ---
DATABASE_POOL_SIZE=10
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
